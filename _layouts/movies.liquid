---
layout: default
---
<div class="post">
  <header class="post-header">
    <h3 class="post-title">{{ page.title }}</h3>
    <sub>{{ page.description }}</sub>
    <p></p>
  </header>
    <div class="movies-grid">
        {% for movie in site.data.movies.favorites %}
        <div class="movie-item" onclick="window.open('{{ movie.imdb_link }}', '_blank')">
            <img src="{{ movie.image }}" alt="{{ movie.title }}">
            <div class="movie-overlay">
                <p>{{ movie.title }}</p>
            </div>
        </div>
        {% endfor %}
    </div>
{{ content }}
</div>